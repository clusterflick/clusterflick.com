rules_version = '2';

// Each user may read and write only their own documents, and only the fields
// the site writes: the film lists and the favourite venues, and the listed
// films' details. Their capabilities they may only read. Everything else is
// denied by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['watchlist', 'seen', 'favouriteVenues']);
    }

    // The listed films' genres and credits, for the lists' stats and filters.
    // Its own document so the lists, read on every page, stay small.
    match /users/{userId}/meta/films {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['films', 'people']);
    }

    // The features granted to the user (see CapabilityId). Granted only with
    // the Admin SDK, which the rules don't apply to, so the user may read it
    // and delete it with their account, and never write it.
    match /users/{userId}/meta/capabilities {
      allow read, delete: if isOwner(userId);
    }
  }

  function isOwner(userId) {
    return request.auth != null && request.auth.uid == userId;
  }
}
