# Firebase web config for personalisation (Project settings → Your apps → Web
# app). Not secrets. Leave unset and personalisation switches itself off.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Only for `npm run migrate-film-details` and `npm run grant-capability`, run
# by hand from your machine. The key can read and write every reader's data:
# keep it outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# TMDB_TOKEN=
# The profiles Worker's PURGE_SECRET, so those scripts can purge the cached
# profiles they change (scripts/lib/purge-profile.js).
# PROFILES_PURGE_SECRET=
